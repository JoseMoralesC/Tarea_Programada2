PORT=4000
DB_SERVER=
DB_PORT=15002
DB_DATABASE=RepuestosAutomotrices
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true

# Identidades SQL distintas; no son las cuentas personales del login GraphQL.
DB_CLIENT_USER=
DB_CLIENT_PASSWORD=
DB_EMPLOYEE_USER=
DB_EMPLOYEE_PASSWORD=

# Debe poder ejecutar dbo.LoginUsuario. No se usa mantenimiento ni empleado.
DB_LOGIN_ROLE=cliente

# Acceso anónimo al catálogo, únicamente si se decide habilitarlo.
DB_GENERIC_ENABLED=false
DB_GENERIC_USER=
DB_GENERIC_PASSWORD=

# Solo herramientas de mantenimiento; la API no consume estas credenciales.
DB_SETUP_AUTH=sql
DB_SETUP_USER=
DB_SETUP_PASSWORD=

# Copiar a .env únicamente si todavía no existe un archivo local.
NODE_ENV=development
PORT=4000
GRAPHQL_PATH=/graphql

DB_SERVER=100.124.109.126
DB_PORT=15002
DB_DATABASE=RepuestosAutomotrices
DB_ENCRYPT=true
# Configuración acordada para este servidor por Tailscale.
DB_TRUST_SERVER_CERTIFICATE=true

# Completar localmente con los accesos ya definidos para cada rol.
# Si la contraseña contiene #, escribirla entre comillas: 'valor_local'.
DB_CLIENT_USER=
DB_CLIENT_PASSWORD=
DB_EMPLOYEE_USER=
DB_EMPLOYEE_PASSWORD=

# Opcional: tercer rol con permisos mínimos para operaciones públicas.
DB_GENERIC_ENABLED=false
DB_GENERIC_USER=
DB_GENERIC_PASSWORD=

# Cuenta local de mantenimiento, separada de las cuentas de la aplicación.
# AUTH: sql o integrated (autenticación Windows del proceso actual).
DB_SETUP_AUTH=sql
DB_SETUP_USER=
DB_SETUP_PASSWORD=
